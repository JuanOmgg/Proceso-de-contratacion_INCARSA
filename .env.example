# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (MySQL)
# ==============================================================================
DB_HOST="localhost"
DB_PORT=3306
DB_USER="tu_usuario_aqui"
DB_PASSWORD="tu_password_aqui"
DB_NAME="incarsa_ingresos"

# ==============================================================================
# SEGURIDAD Y TOKENS JWT
# ==============================================================================
# Genere una clave segura en terminal con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY="cambiar_por_una_clave_secreta_criptografica_fuerte"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ==============================================================================
# CONFIGURACIÓN DE CORREO SALIENTE (SMTP)
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="tu_correo_soporte@gmail.com"
SMTP_PASSWORD="tu_contraseña_de_aplicacion"
SMTP_FROM_NAME="INCARSA Soporte"

# ==============================================================================
# CONTROL DE ORÍGENES Y CORS (Separados por comas si son varios)
# ==============================================================================
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
FRONTEND_URL=""
ENVIRONMENT="development"
